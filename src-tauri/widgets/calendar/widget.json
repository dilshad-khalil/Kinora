{
  "name": "Calendar",
  "description": "This month at a glance, with today highlighted.",
  "author": "Kinora",
  "version": "1.0.0",
  "entry": "index.html",
  "size": { "width": 230, "height": 210, "minWidth": 160, "minHeight": 150, "resizable": true },
  "radius": 24,
  "permissions": [],
  "settings": [
    { "key": "weekStart", "type": "select", "label": "Week starts on", "options": ["monday", "sunday", "saturday"], "default": "monday" },
    { "key": "weekend", "type": "toggle", "label": "Dim weekends", "default": true },
    { "key": "theme", "type": "select", "label": "Theme", "options": ["dark", "light", "clear"], "default": "dark" },
    { "key": "accent", "type": "color", "label": "Accent", "default": "#ff453a" }
  ]
}
